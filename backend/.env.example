DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DATABASE
AUTH_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set this to production or staging in deployed environments.
APP_ENV=development
# Local HTTP development may disable Secure; deployed environments may not.
AUTH_COOKIE_SECURE=false
AUTH_SESSION_SECONDS=28800
AUTH_REMEMBER_SECONDS=2592000
AUTH_FAILURE_WINDOW_SECONDS=900
AUTH_ACCOUNT_FAILURE_LIMIT=5
AUTH_IP_FAILURE_LIMIT=30
AUTH_LOCK_BASE_SECONDS=30
AUTH_LOCK_MAX_SECONDS=900
DOCUMENT_JOB_POLL_SECONDS=1
DOCUMENT_JOB_LEASE_SECONDS=3600
DOCUMENT_JOB_HEARTBEAT_SECONDS=30
DOCUMENT_JOB_MAX_ATTEMPTS=5
DOCUMENT_JOB_RETRY_BASE_SECONDS=30
DOCUMENT_JOB_RETRY_MAX_SECONDS=1800
# Optional local log file. Leave empty in containers and use platform log rotation.
LOG_FILE=
LOG_LEVEL=INFO
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
RATE_LIMIT_REDIS_URL=
CONNECTOR_SCHEDULER_POLL_SECONDS=60
CONNECTOR_SECRET_MANAGER_URL=https://secrets.internal.example
CONNECTOR_SECRET_MANAGER_TOKEN=
CONNECTOR_SECRET_MANAGER_TIMEOUT_SECONDS=3

# OCR is disabled by default, so documents stay local until a provider is set.
# With auto, MinerU is tried first, then Google Vision and Azure if configured.
OCR_PROVIDER=disabled
OCR_LANGUAGE_HINTS=fa,en
OCR_TIMEOUT_SECONDS=30
OCR_MAX_PAGES=100
MINERU_API_TOKEN=
MINERU_API_BASE_URL=https://mineru.net/api/v4
MINERU_MODEL_VERSION=vlm
MINERU_LANGUAGE=fa
MINERU_TIMEOUT_SECONDS=300
MINERU_POLL_SECONDS=2
GOOGLE_VISION_API_KEY=
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# Existing RAG configuration
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_chunks
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Cloud connectors (configure only the providers you use)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
