# Copy this file to .env and replace every value marked CHANGE_ME.
# .env is ignored by Git and is read by Docker Compose.

POSTGRES_DB=nexora
POSTGRES_USER=nexora
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_DATABASE_PASSWORD

DATABASE_URL=postgresql+psycopg2://nexora:CHANGE_ME_TO_A_LONG_RANDOM_DATABASE_PASSWORD@postgres:5432/nexora
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_chunks

# Docker Compose is configured for local HTTP by default. Change both values
# together for a public HTTPS deployment.
APP_ENV=development
AUTH_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_VALUE_AT_LEAST_32_CHARACTERS_LONG
AUTH_COOKIE_SECURE=false
FRONTEND_ORIGINS=http://localhost:5173

# Keep OCR disabled unless a provider and its credentials are configured.
OCR_PROVIDER=disabled
OCR_LANGUAGE_HINTS=fa,en

# Enable the optional ClamAV profile and set MALWARE_SCAN_MODE=required for a
# production deployment. The application rejects uploads if the scanner is unavailable.
MALWARE_SCAN_MODE=disabled
CLAMD_HOST=clamav
CLAMD_PORT=3310
CLAMD_TIMEOUT_SECONDS=15
MALWARE_RETAIN_DETECTED=false

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Set this when the Compose port must differ from 5173.
NEXORA_PORT=5173
